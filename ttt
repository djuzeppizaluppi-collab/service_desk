-- ДОБАВЛЕНО S_SR:
-- Остатки на счетах ПДС по трем мнемоникам.
-- Названия колонок balance необходимо сопоставить
-- с фактической структурой таблицы.

sr_balance AS (
    SELECT
        b.owner_sharer_id AS id,

        SUM(b.balance_value) FILTER (
            WHERE at2.mnemonics = 'ПДС СВ'
        ) AS balance_sv,

        SUM(b.balance_value) FILTER (
            WHERE at2.mnemonics = 'ПДС ГВ СБ'
        ) AS balance_gv,

        SUM(b.balance_value) FILTER (
            WHERE at2.mnemonics = 'ПДС СВ ИД'
        ) AS balance_id

    FROM back_office.balance b

    JOIN back_office.account a
        ON a.id = b.account_id

    JOIN back_office.account_type at2
        ON at2.id = a.account_type_id

    WHERE a.owner_sharer_id = p_sharer_id

      -- ИЗМЕНЕНО: берем остатки, действующие
      -- на дату расчета
      AND b.start_date <= p_calc_date
      AND b.end_date >= p_calc_date

      AND at2.mnemonics IN (
          'ПДС СВ',
          'ПДС ГВ СБ',
          'ПДС СВ ИД'
      )

    GROUP BY b.owner_sharer_id
),

-- ДОБАВЛЕНО S_SR:
-- Общий баланс и сумма списания в страховой резерв

sr_calc AS (
    SELECT
        COALESCE(sb.balance_sv, 0)::numeric AS balance_sv,
        COALESCE(sb.balance_gv, 0)::numeric AS balance_gv,
        COALESCE(sb.balance_id, 0)::numeric AS balance_id,

        (
            COALESCE(sb.balance_sv, 0)
            + COALESCE(sb.balance_gv, 0)
            + COALESCE(sb.balance_id, 0)
        )::numeric AS balance_total,

        GREATEST(
            0,
            COALESCE(sb.balance_sv, 0)
            + COALESCE(sb.balance_gv, 0)
            + COALESCE(sb.balance_id, 0)
            - COALESCE(cv.s_vykup, 0)
        )::numeric AS s_sr

    FROM base b

    LEFT JOIN sr_balance sb
        ON sb.id = b.id

    CROSS JOIN calc_vykup cv
)

's_sr',
jsonb_build_object(
    'amount', sr.s_sr,
    'balance_total', sr.balance_total,
    'balance_sv', sr.balance_sv,
    'balance_gv', sr.balance_gv,
    'balance_id', sr.balance_id,
    's_vykup', cv.s_vykup
),
