if p_calc_type = 'PAYMENT' and v_service_type = 'PDS' and v_is_nonstandard = false then
			return query
				with base as (
					select
						s.id,
						s.contract_id,
						case
							when c.individual_id = s.individual_id
							then 'Вкладчик'
							when appl.individual_id = c.individual_id
								and appl.individual_id != s.individual_id 
							then 'Вкладчик'
							when appl.individual_id = s.individual_id 
							then 'Участник'
							else 'Вкладчик'
						end as who
					from ourpension.sharer s
					join ourpension.contract c on c.id = s.contract_id
					left join lateral (
						select distinct on (atc.sharer_id)
							atc.sharer_id,
							atc.application_personal_data_individual_id as individual_id
						from ourpension.application_termination_contract atc
						where atc.sharer_id = s.id
							and atc."date" <= p_calc_date
						order by atc.sharer_id, atc."date" desc, atc."version" desc
					) appl on true
					where s.id = p_sharer_id
				),
				trans_raw_credit as (
					select
						s.id,
						ot.code as operation_name,
						at2.mnemonics,
						sum(t.value) as trans_amount
					from back_office.operation o
					join back_office.transaction t on o.id = t.operation_id 
					join back_office.account a on t.credit_account_id = a.id
					join back_office.account_type at2 on at2.id = a.account_type_id
					join ourpension.sharer s on s.id = a.owner_sharer_id
					join back_office.operation_type ot on ot.id = o.operation_type_id
					where s.id = p_sharer_id
						and t.effective_date <= p_calc_date
						and ot.code in ( 
							select distinct sc.operation_type_code 
			                from actuary.settings_for_redemption_calculation sc
			                where sc."service_type" = 'PDS' 
				                and sc.operation_type_code is not null
				                and sc.calculation_type = 'PAYMENT'
				                and sc.direction = 'credit'
				        )
						and at2.mnemonics in (
							select distinct sc.mnemonics 
			                from actuary.settings_for_redemption_calculation sc
			                where sc."service_type" = 'PDS' 
				                and sc.mnemonics is not null
				                and sc.calculation_type = 'PAYMENT'
				                and sc.direction = 'credit'
				        )
					group by s.id, ot.code, at2.mnemonics
				),
				trans_raw_debit as (
					select
						s.id,
						ot.code as operation_name,
						sum(t.value) as trans_amount
					from back_office.operation o
					join back_office.transaction t on o.id = t.operation_id 
					join back_office.account a on t.debit_account_id = a.id
					join ourpension.sharer s on s.id = a.owner_sharer_id
					join back_office.operation_type ot on ot.id = o.operation_type_id
					where s.id = p_sharer_id
						and t.effective_date <= p_calc_date
						and ot.code in (
							select distinct sc.operation_type_code 
			                from actuary.settings_for_redemption_calculation sc
			                where sc."service_type" = 'PDS' 
				                and sc.operation_type_code is not null
				                and sc.calculation_type = 'PAYMENT'
				                and sc.direction = 'debit'
						)
					group by s.id, ot.code
				),
				trans_calc_credit as (	
					select
						sum(trc.trans_amount)
							filter(where trc.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'PDS' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'PAYMENT'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_vznos'
										)
										and trc.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'PDS' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'PAYMENT'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_vznos'
										)
						) as s_vznos,
						sum(trc.trans_amount)
							filter(where trc.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'PDS' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'PAYMENT'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_finrez'
										)
										and trc.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'PDS' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'PAYMENT'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_finrez'
										)
						) as s_finrez,
						sum(trc.trans_amount)
							filter(where trc.mnemonics in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'PDS' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'PAYMENT'
								                and sc.direction = 'credit'
								                and sc.s_ts = 's_vosp'
										)
						) as s_vosp,
						trc.id,
						jsonb_agg(
							jsonb_build_object(
								'mnemonics', trc.mnemonics,
								'amount', trc.trans_amount
							)
							order by
								trc.mnemonics
						) as credit_included_json
					from trans_raw_credit trc
					where trc.operation_name not in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'PDS' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'PAYMENT'
								                and sc.direction = 'credit'
								                and sc.s_ts = 'onetime_or_add'
						)
						and trc.mnemonics not in (
											select distinct sc.mnemonics 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'PDS' 
								                and sc.mnemonics is not null
								                and sc.calculation_type = 'PAYMENT'
								                and sc.direction = 'credit'
								                and sc.s_ts = 'onetime_or_add'
						)
					group by trc.id
				),
				coeff_prepare as (
					select
						bool_or(
							trc.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'PDS' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'PAYMENT'
								                and sc.direction = 'credit'
								                and sc.s_ts = 'onetime_or_add'
										)
						) as is_onetime_or_add_contribution,
						trc.id
					from trans_raw_credit trc
					group by trc.id
				),
				trans_calc_debit as (	
					select
						sum(trd.trans_amount)
							filter(where trd.operation_name in (
											select distinct sc.operation_type_code 
							                from actuary.settings_for_redemption_calculation sc
							                where sc."service_type" = 'PDS' 
								                and sc.operation_type_code is not null
								                and sc.calculation_type = 'PAYMENT'
								                and sc.direction = 'debit'
								                and sc.s_ts = 's_vypl'
										)
						) as s_vypl,
						trd.id,
						jsonb_agg(
							jsonb_build_object(
								'operation_name', trd.operation_name,
								'amount', trd.trans_amount
							)
							order by trd.operation_name
						) as debit_included_json
					from trans_raw_debit trd
					group by trd.id
				),
				not_included_trans_credit as (
					select
						s.id,
						ot.code as operation_name,
						at2.mnemonics,
						sum(t.value) as trans_amount
					from back_office.operation o
					join back_office.transaction t on o.id = t.operation_id 
					join back_office.account a on t.credit_account_id = a.id
					join back_office.account_type at2 on at2.id = a.account_type_id
					join ourpension.sharer s on s.id = a.owner_sharer_id
					join back_office.operation_type ot on ot.id = o.operation_type_id
					where s.id = p_sharer_id
						and t.effective_date = p_calc_date
						and ot.code not in (select operation_name from trans_raw_credit)
						and at2.mnemonics not in (select mnemonics from trans_raw_credit)
					group by s.id, ot.code, at2.mnemonics
				),
				not_included_trans_credit_json as (
					select
						nit.id,
						jsonb_agg(
							jsonb_build_object(
								'mnemonics', nit.mnemonics,
								'amount', nit.trans_amount
							)
							order by
								nit.mnemonics
						) as credit_not_included_json
					from not_included_trans_credit nit
					group by nit.id
				),
				not_included_trans_debit as (
					select
						s.id,
						ot.code as operation_name,
						sum(t.value) as trans_amount
					from back_office.operation o
					join back_office.transaction t on o.id = t.operation_id 
					join back_office.account a on t.debit_account_id = a.id
					join ourpension.sharer s on s.id = a.owner_sharer_id
					join back_office.operation_type ot on ot.id = o.operation_type_id
					where s.id = p_sharer_id
						and t.effective_date = p_calc_date
						and not exists (
							select 1
							from trans_raw_debit trd
							where trd.operation_name = ot.code
						)
					group by s.id, ot.code
				),
				not_included_trans_debit_json as (
					select
						nit.id,
						jsonb_agg(
							jsonb_build_object(
								'operation_name', nit.operation_name,
								'amount', nit.trans_amount
							)
							order by nit.operation_name
						) as debit_not_included_json
					from not_included_trans_debit nit
					group by nit.id
				),
				calc_params as (
					select
						coalesce(tcc.s_vznos, 0) as s_vznos,
						coalesce(tcc.s_finrez, 0) as s_finrez,
						coalesce(tcc.s_vosp, 0) as s_vosp,
						coalesce(tcd.s_vypl, 0) as s_vypl
					from base b
					left join trans_calc_credit tcc on tcc.id = b.id
					left join trans_calc_debit tcd on tcd.id = b.id
				),
				coeff_params as (
					select
						coalesce(t.k1, 1)::numeric as k1,
						coalesce(t.k2, 1)::numeric as k2,
						case
							when t.sharer_id is null
                    		then jsonb_build_object('code', 'REDEMPTION_COEFF_NOT_FOUND')
                    		else t.details_json 
                    	end as details_json
					from base b
					left join coeff_prepare tcc on tcc.id = b.id
					left join lateral (
						select
							grc.sharer_id,
							grc.k1,
							grc.k2,
							grc.details_json
						from actuary.get_redemption_coeff(
							b.id, '{}'::integer[], 'PDS', p_calc_date, b.who, 
							tcc.is_onetime_or_add_contribution, null
						) grc
						where grc.sharer_id = b.id
					) t on true
				),
				credit_json_calc
				calc_vykup as (
					select
						greatest(0,
							cp1.k1 * coalesce(cp.s_vznos, 0) +
							cp1.k2 * (coalesce(cp.s_finrez, 0) + coalesce(cp.s_vosp, 0)) -
							coalesce(cp.s_vypl, 0)
						) as s_vykup
					from calc_params cp
					cross join coeff_params cp1
				),
				sr_balance as (
				    select
				        a.owner_sharer_id as id,
				        sum(b.total_credit - b.total_debit) filter (
				            where at2.mnemonics = 'ПДС СВ'
				        ) as balance_sv,
				        sum(b.total_credit - b.total_debit) filter (
				            where at2.mnemonics = 'ПДС ГВ СБ'
				        ) as balance_gv_sb,
				        sum(b.total_credit - b.total_debit) filter (
				            where at2.mnemonics = 'ПДС СВ ИД'
				        ) as balance_sv_id
				    from back_office.balance b
				    join back_office.account a on a.id = b.account_id
				    join back_office.account_type at2 on at2.id = a.account_type_id
				    where a.owner_sharer_id = p_sharer_id
					    and b.start_date <= p_calc_date
					    and b.end_date >= p_calc_date
					    and at2.mnemonics in (
						    'ПДС СВ',
						    'ПДС ГВ СБ',
						    'ПДС СВ ИД'
					    )
				    group by a.owner_sharer_id
				),
				sr_calc as (
				    select
				        coalesce(sb.balance_sv, 0)::numeric as balance_sv,
				        coalesce(sb.balance_gv_sb, 0)::numeric as balance_gv_sb,
				        coalesce(sb.balance_sv_id, 0)::numeric as balance_sv_id,
				        (
				            coalesce(sb.balance_sv, 0)
				            + coalesce(sb.balance_gv_sb, 0)
				            + coalesce(sb.balance_sv_id, 0)
				        )::numeric as balance_total,
				        greatest(
				            0,
				            coalesce(sb.balance_sv, 0)
				            + coalesce(sb.balance_gv_sb, 0)
				            + coalesce(sb.balance_sv_id, 0)
				            - coalesce(cv.s_vykup, 0)
				        )::numeric as s_sr
				    from base b
				    left join sr_balance sb on sb.id = b.id
				    cross join calc_vykup cv
				)
				select
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cv.s_vykup, v_service_type) r
						)
					, 0)::numeric,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_vznos, v_service_type) r
						)
					, 0)::numeric,
					null::numeric as s_dd,
					null::numeric as s_mgd,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_vosp, v_service_type) r
						)
					, 0)::numeric,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_vypl, v_service_type) r
						)
					, 0)::numeric,
					null::numeric as s_perevod,
					coalesce((
						select r.pension
						from actuary.round_calc_res(v_round_type, cp.s_finrez, v_service_type) r
						)
					, 0)::numeric,
					coalesce(cp1.k1, 0)::numeric,
					coalesce(cp1.k2, 0)::numeric,
					null::numeric,
					null::numeric,
					null::numeric,
					null::numeric as d,
					jsonb_build_object(
						'credit_included',
						coalesce(tcc.credit_included_json, '[]'::jsonb),
						'credit_not_included',
						coalesce(nitcj.credit_not_included_json, '[]'::jsonb),
						
						'debit_included',
						coalesce(tcd.debit_included_json, '[]'::jsonb),
						'debit_not_included',
						coalesce(nitdj.debit_not_included_json, '[]'::jsonb),
						's_sr',
						jsonb_build_object(
						    'amount', sr.s_sr,
						    'balance_total', sr.balance_total,
						    'balance_sv', sr.balance_sv,
						    'balance_gv_sb', sr.balance_gv_sb,
						    'balance_sv_id', sr.balance_sv_id,
						    's_vykup', cv.s_vykup
						),
						'exception',
						jsonb_build_object(
							'error', cp1.details_json
						)
					)::jsonb as details_json
				from calc_params cp
				cross join coeff_params cp1
				cross join calc_vykup cv
				cross join sr_calc sr
				left join trans_calc_credit tcc on true
				left join trans_calc_debit tcd on true
				left join not_included_trans_credit_json nitcj on true
				left join not_included_trans_debit_json nitdj on true;
		
		end if;
