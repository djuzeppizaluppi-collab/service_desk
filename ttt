WITH
/* ============================================================
   1. СНАЧАЛА ОТБИРАЕМ ТОЛЬКО НУЖНЫХ SHARER
   ============================================================ */

npo_sharer AS MATERIALIZED (
    SELECT
        s.id AS sharer_id
    FROM ourpension.sharer s
    JOIN ourpension.contract c
      ON c.id = s.contract_id
    WHERE c."service_type" = 'NPO'
),

/*
 * Последний статус ДО начала периода.
 *
 * ВАЖНО:
 * сначала находим реально последний статус,
 * и только потом ниже проверяем его code.
 *
 * Нельзя здесь фильтровать code IN (...) до DISTINCT ON,
 * иначе получим "последний подходящий", а не последний вообще.
 */
last_status_before AS MATERIALIZED (
    SELECT DISTINCT ON (ssh.sharer_id)
        ssh.sharer_id,
        ssh.code
    FROM ourpension.sharer_statuses_history ssh
    JOIN npo_sharer ns
      ON ns.sharer_id = ssh.sharer_id
    WHERE ssh.status_date < p_start_date
    ORDER BY
        ssh.sharer_id,
        ssh.status_date DESC,
        ssh.id DESC
),

/*
 * В исходнике условие было:
 *
 * last_before_ssh.code IN ('HAO','GAO','FAO')
 * OR EXISTS(status в периоде)
 *
 * Переносим его В НАЧАЛО запроса.
 */
eligible_sharer AS MATERIALIZED (
    SELECT
        lsb.sharer_id
    FROM last_status_before lsb
    WHERE lsb.code IN ('HAO', 'GAO', 'FAO')

    UNION

    SELECT
        ssh.sharer_id
    FROM ourpension.sharer_statuses_history ssh
    JOIN npo_sharer ns
      ON ns.sharer_id = ssh.sharer_id
    WHERE ssh.code IN ('HAO', 'GAO', 'FAO')
      AND ssh.status_date >= p_start_date
      AND ssh.status_date <  v_datetime_end
    GROUP BY ssh.sharer_id
),


/* ============================================================
   2. ОСНОВНАЯ БАЗА SHARER
   ============================================================ */

sharer_base AS MATERIALIZED (
    SELECT
        s.id AS sharer_id,

        c.effective_date AS contract_effective_date,

        i.counterparty_code_1c AS code,
        c.code_1c AS contract_code_1c,
        s.code_1c AS sharer_code_1c,

        s.number AS sharer_number,
        c.number AS contract_number,

        csh_sign.status_date::date AS sign_date,
        ssh_eff.status_date::date AS effective_date,

        CASE
            WHEN c.entity_id IS NULL THEN 'ФЛ'
            ELSE e.name
        END AS name_investor,

        CASE
            WHEN c.client_type = 0 THEN 'ФЛ'
            ELSE 'ЮЛ'
        END AS type_investor,

        CASE
            WHEN c.individual_id IS NULL THEN 1
            ELSE NULL
        END AS investor_sharer,

        CASE
            WHEN i.sex = 'M' THEN 'M'
            ELSE 'Ж'
        END AS sex,

        i.birth_date,
        i.sex AS sex_raw,

        extract(
            year FROM age(p_end_date, i.birth_date)
        )::smallint AS age,

        f.name_in_pfr,

        ps0.investment_portfolio_name,

        CASE
            WHEN sp.sharer_type IN ('SPS_U', 'SPS_P')
                THEN 'СПС'
            WHEN sp.sharer_type IN ('KIPS', 'IPS_P', 'IPS')
                THEN 'ИПС'
        END AS account_type,

        date(s.created) AS registr_date,

        ve.value_income,

        coalesce(
            ve.min_actuarial_yield,
            0
        ) AS get_actuary_rate,

        sp.min_actuarial_yield * 100 AS actuary_rate,

        /*
         * В исходнике этот assignee_type далее фактически
         * берется из get_pension_scheme.
         * Оставляю основной источник ниже.
         */

        'ФЛ'::text AS sharer_type,

        CASE
            WHEN edp.times_in_year = 1  THEN 'год'
            WHEN edp.times_in_year = 2  THEN 'полугодие'
            WHEN edp.times_in_year = 4  THEN 'квартал'
            WHEN edp.times_in_year = 12 THEN 'месяц'
            ELSE NULL
        END AS period_pay_pension,

        edp.times_in_year AS pension_count,
        edp.value_pension AS pension_value,

        CASE
            WHEN ssh_tg.code = 'GAO' THEN 'НП'
            WHEN ssh_tg.code = 'HAO' THEN 'ПВ'
            ELSE 'НР'
        END AS type_group,

        sdp.period_start_date AS start_date_pension,

        CASE
            WHEN edp.short_name = 'Срочная'
                THEN edp.period_end_date
            ELSE NULL
        END AS end_date_pension_period,

        edp.period_end_date AS end_date_pay_pension,

        psh.status_date::date AS suspend_pay_date,

        clas.class_id AS contract_type,

        fl.name_in_pfr AS fund,

        lower(edp.short_name) AS period_pension,

        CASE
            WHEN clsh.name = 'Инвестиционный'
                THEN 1::integer
            ELSE 2::integer
        END AS class_sharer,

        CASE
            WHEN clsh.name = 'Инвестиционный'
             AND ssh_tg.code = 'HAO'
                THEN 1::integer
            ELSE 0::integer
        END AS "TYPE",

        ish.individual_sharer_status,

        appl_term.appl_term_sharer_id,

        obligation.obligation_types,

        di.death_date,

        transfer_out_all.redemption_sharer_id
            AS transfer_out_all_redemption_sharer_id

    FROM eligible_sharer es

    JOIN ourpension.sharer s
      ON s.id = es.sharer_id

    JOIN ourpension.contract c
      ON c.id = s.contract_id

    LEFT JOIN ourpension.sharer_param sp
      ON sp.sharer_id = s.id

    LEFT JOIN ourpension.pension_scheme ps0
      ON ps0.id = s.scheme_id

    LEFT JOIN ourpension.entity e
      ON e.id = c.entity_id

    LEFT JOIN ourpension.individual i
      ON i.id = c.individual_id

    LEFT JOIN ourpension.fund fl
      ON fl.id = c.sign_fund_id

    LEFT JOIN ourpension.fund f
      ON f.id = c.fund_id


    /* --------------------------------------------------------
       Расторжение / redemption
       -------------------------------------------------------- */
    LEFT JOIN LATERAL (
        SELECT
            tcc.sharer_id AS redemption_sharer_id,
            tcc.date AS value_date
        FROM back_office.termination_contract_calculation tcc
        WHERE tcc.service_type = 'NPO'
          AND tcc.accepted IS NOT NULL
          AND tcc.canceled IS NULL
          AND tcc.rejected IS NULL
          AND tcc.date <= p_end_date
          AND tcc.sharer_id = s.id
        ORDER BY tcc.date ASC
        LIMIT 1
    ) transfer_out_all
      ON TRUE


    /* --------------------------------------------------------
       Тип обязательства
       -------------------------------------------------------- */
    LEFT JOIN LATERAL (
        SELECT
            vpot.label AS obligation_types,

            CASE
                WHEN f.date_reorganization IS NULL
                    THEN greatest(
                        poth.start_date,
                        p_start_date
                    )
                ELSE greatest(
                        poth.start_date,
                        p_start_date,
                        f.date_reorganization
                    )
            END AS status_oblig_start,

            CASE
                WHEN poth.end_date = DATE '9999-01-01'
                    THEN NULL
                ELSE poth.end_date
            END AS close_status_oblig_end

        FROM ourpension.pension_obligation_types_history poth

        JOIN ourpension.voc_pension_obligation_types vpot
          ON vpot.id = poth.type_id

        WHERE poth.sharer_id = s.id
          AND poth.end_date >
              CASE
                  WHEN f.date_reorganization IS NOT NULL
                      THEN greatest(
                          f.date_reorganization,
                          p_start_date
                      )
                  ELSE p_start_date
              END

        ORDER BY poth.start_date DESC
        LIMIT 1
    ) obligation
      ON TRUE


    /* --------------------------------------------------------
       Последний статус приостановки выплат
       -------------------------------------------------------- */
    LEFT JOIN LATERAL (
        SELECT
            psh.status_date
        FROM ourpension.payment_statuses_history psh
        WHERE psh.sharer_id = s.id
          AND psh.status_id = 2
          AND psh.status_date < v_datetime_end
        ORDER BY psh.status_date DESC
        LIMIT 1
    ) psh
      ON TRUE


    /* --------------------------------------------------------
       Статус физлица на конец периода
       -------------------------------------------------------- */
    LEFT JOIN LATERAL (
        SELECT
            CASE
                WHEN ish.enum_status_id = 681
                    THEN 'Действующий'
                WHEN ish.enum_status_id = 682
                    THEN 'Выбывший'
                ELSE 'Неопределено'
            END AS individual_sharer_status

        FROM ourpension.individual_status_history ish

        WHERE ish.individual_id = i.id
          AND ish.service_type = 'NPO'
          AND v_datetime_end
              BETWEEN ish.status_date_start
                  AND coalesce(
                      ish.status_date_end,
                      timestamp '9999-01-01'
                  )

        ORDER BY ish.status_date_start DESC
        LIMIT 1
    ) ish
      ON TRUE


    /* --------------------------------------------------------
       Заявление на расторжение в отчетном периоде
       -------------------------------------------------------- */
    LEFT JOIN LATERAL (
        SELECT
            atcd.sharer_id AS appl_term_sharer_id

        FROM ourpension.application_termination_contract_data atcd

        JOIN ourpension.application_termination_contract atc
          ON atcd.application_termination_contract_id = atc.id

        WHERE atcd.sharer_id = s.id
          AND atc.date >= p_start_date
          AND atc.date <  v_datetime_end
          AND atc.rejected IS NULL

        ORDER BY atc.date DESC
        LIMIT 1
    ) appl_term
      ON TRUE


    /* --------------------------------------------------------
       Сведения о смерти
       -------------------------------------------------------- */
    LEFT JOIN LATERAL (
        SELECT
            adi.individual_id,
            adi.death_date,
            adi.death_info_date

        FROM ourpension.application_death_info adi

        WHERE adi.accepted IS NOT NULL
          AND adi.canceled IS NULL
          AND adi.rejected IS NULL
          AND adi.individual_id = i.id

        ORDER BY adi.version DESC
        LIMIT 1
    ) di
      ON TRUE


    /* --------------------------------------------------------
       Последний класс sharer
       -------------------------------------------------------- */
    LEFT JOIN LATERAL (
        SELECT
            cc.name

        FROM ourpension.sharer_class_history sch

        JOIN ourpension.contract_classes cc
          ON cc.id = sch.class_id

        WHERE sch.sharer_id = s.id
          AND sch.begin_date < v_datetime_end

        ORDER BY sch.begin_date DESC
        LIMIT 1
    ) clsh
      ON TRUE


    /* --------------------------------------------------------
       Последний класс договора
       Условие begin_date >= p_start_date оставляю как в исходнике.
       -------------------------------------------------------- */
    LEFT JOIN LATERAL (
        SELECT
            cch.class_id

        FROM ourpension.contract_class_history cch

        WHERE cch.contract_id = c.id
          AND cch.begin_date >= p_start_date

        ORDER BY cch.begin_date DESC
        LIMIT 1
    ) clas
      ON TRUE


    /* --------------------------------------------------------
       Первый расчет пенсии
       -------------------------------------------------------- */
    LEFT JOIN LATERAL (
        SELECT
            CASE
                WHEN pc.period_start_date > DATE '1992-09-16'
                 AND pc.period_start_date IS NOT NULL
                    THEN pc.period_start_date
                ELSE pc.calculation_date
            END AS period_start_date,

            coalesce(
                pcs1.value_pension,
                pcs3.value_pension
            ) AS value_pension

        FROM back_office.pension_calculation pc

        LEFT JOIN back_office.pension_calculation_scheme1 pcs1
          ON pcs1.pension_calculation_id = pc.id

        LEFT JOIN back_office.pension_calculation_scheme3 pcs3
          ON pcs3.pension_calculation_id = pc.id

        JOIN ourpension.npo_decision_payment_type ndpt
          ON ndpt.code = pc.npo_decision_payment_type_code

        JOIN back_office.npo_decision_type ndt
          ON ndt.id = pc.npo_decision_type_id

        WHERE pc.sharer_id = s.id
          AND pc.calculation_date <= p_end_date
          AND ndpt.short_name IN (
              'До исчерпания',
              'Срочная',
              'Пожизненная'
          )
          AND ndt.code = 'УСТН'

        ORDER BY pc.calculation_date ASC
        LIMIT 1
    ) sdp
      ON TRUE


    /* --------------------------------------------------------
       Последний расчет пенсии
       -------------------------------------------------------- */
    LEFT JOIN LATERAL (
        SELECT
            pc.period_end_date,
            ndpt.short_name,

            coalesce(
                pcs1.value_pension,
                pcs3.value_pension
            ) AS value_pension,

            coalesce(
                pcs1.times_in_year,
                pcs3.times_in_year
            ) AS times_in_year

        FROM back_office.pension_calculation pc

        JOIN ourpension.npo_decision_payment_type ndpt
          ON ndpt.code = pc.npo_decision_payment_type_code

        JOIN back_office.npo_decision_type ndt
          ON ndt.id = pc.npo_decision_type_id

        LEFT JOIN back_office.pension_calculation_scheme1 pcs1
          ON pcs1.pension_calculation_id = pc.id

        LEFT JOIN back_office.pension_calculation_scheme3 pcs3
          ON pcs3.pension_calculation_id = pc.id

        WHERE pc.sharer_id = s.id
          AND pc.calculation_date <= p_end_date
          AND ndpt.short_name IN (
              'До исчерпания',
              'Срочная',
              'Пожизненная'
          )
          AND ndt.code IN ('УСТН', 'КОРР')

        ORDER BY pc.calculation_date DESC
        LIMIT 1
    ) edp
      ON TRUE


    /* --------------------------------------------------------
       Последний GAO/HAO до конца периода
       -------------------------------------------------------- */
    LEFT JOIN LATERAL (
        SELECT
            ssh.code
        FROM ourpension.sharer_statuses_history ssh
        WHERE ssh.sharer_id = s.id
          AND ssh.code IN ('GAO', 'HAO')
          AND ssh.status_date < v_datetime_end
        ORDER BY
            ssh.status_date DESC,
            ssh.id DESC
        LIMIT 1
    ) ssh_tg
      ON TRUE


    /* --------------------------------------------------------
       Дата effective.
       В исходнике code/id = 1.
       Здесь оставляю именно эту логику.
       -------------------------------------------------------- */
    LEFT JOIN LATERAL (
        SELECT
            ssh.status_date
        FROM ourpension.sharer_statuses_history ssh
        WHERE ssh.sharer_id = s.id
          AND ssh.id = 1       -- !!! ПРОВЕРЬ: на фото именно ssh.id = 1
        ORDER BY ssh.status_date
        LIMIT 1
    ) ssh_eff
      ON TRUE


    /* --------------------------------------------------------
       Дата подписания договора
       -------------------------------------------------------- */
    LEFT JOIN LATERAL (
        SELECT
            csh.status_date
        FROM ourpension.contract_statuses_history csh
        WHERE csh.contract_id = c.id
          AND csh.id = 1       -- !!! ПРОВЕРЬ: на фото именно csh.id = 1
        ORDER BY csh.status_date
        LIMIT 1
    ) csh_sign
      ON TRUE


    /* --------------------------------------------------------
       Параметры договора
       -------------------------------------------------------- */
    LEFT JOIN LATERAL (
        SELECT
            CASE
                WHEN cp.min_annual_income_period > 0
                    THEN cp.min_annual_income_period
                WHEN cp.min_annual_savings_income > 0
                    THEN cp.min_annual_savings_income
                ELSE 0::numeric
            END AS value_income,

            cp.min_actuarial_yield

        FROM ourpension.contract_params cp

        WHERE cp.contract_id = c.id

        LIMIT 1
    ) ve
      ON TRUE

    WHERE c."service_type" = 'NPO'
),


/* ============================================================
   3. GET_PENSION_SCHEME
   УБИРАЕМ ДЕКАРТОВО ПРОИЗВЕДЕНИЕ ИЗ ИСХОДНИКА
   ============================================================ */

sharer_ids AS MATERIALIZED (
    SELECT
        array_agg(
            sb.sharer_id
            ORDER BY sb.sharer_id
        )::integer[] AS sharer_ids
    FROM sharer_base sb
),

pension_scheme_raw AS MATERIALIZED (
    SELECT
        gps.*
    FROM sharer_ids a

    CROSS JOIN LATERAL actuary.get_pension_scheme(
        a.sharer_ids,
        '{}'::integer[],
        p_end_date,
        'NPO'
    ) gps
),

pension_scheme AS MATERIALIZED (
    SELECT
        gps.sharer_id,

        gps.name AS pension_scheme_name,

        CASE
            WHEN sb.type_group = 'НП'
                THEN gps.mgd_accum
            ELSE 0::numeric
        END AS mgd_accum,

        CASE
            WHEN sb.type_group = 'ПВ'
                THEN gps.mgd_pay
            ELSE 0::numeric
        END AS mgd_pay,

        CASE
            WHEN gps.inheritance_on_pay = 'true'
             AND gps.inheritance_on_accum = 'true'
                THEN 'полное'

            WHEN gps.inheritance_on_pay = 'false'
             AND gps.inheritance_on_accum = 'true'
                THEN 'накопительное'

            WHEN gps.inheritance_on_pay = 'false'
             AND gps.inheritance_on_accum = 'false'
                THEN 'нет'

            ELSE 'нет'
        END AS assignee_type,

        gps.min_deposit_value AS valueInpaymentContract,

        gps.oud

    FROM pension_scheme_raw gps

    JOIN sharer_base sb
      ON sb.sharer_id = gps.sharer_id
),


/* ============================================================
   4. ПЕРВЫЙ ВЗНОС
   Отдельно от credit_tx, потому что здесь нужен первый взнос
   за ВСЮ историю до p_end_date.
   ============================================================ */

first_inpay_day AS MATERIALIZED (
    SELECT
        sb.sharer_id,
        t.effective_date::date AS effective_date,
        sum(t.value) AS value_inpayment_first

    FROM sharer_base sb

    JOIN back_office.account a
      ON a.owner_sharer_id = sb.sharer_id

    JOIN back_office.transaction t
      ON t.credit_account_id = a.id

    JOIN back_office.operation o
      ON o.id = t.operation_id

    JOIN back_office.operation_type ot
      ON ot.id = o.operation_type_id
     AND ot.code = 'DEPOSIT_ENROLLMENT'

    WHERE t.effective_date < v_datetime_end

    GROUP BY
        sb.sharer_id,
        t.effective_date::date
),

first_inpay AS MATERIALIZED (
    SELECT DISTINCT ON (f.sharer_id)
        f.sharer_id,

        f.effective_date AS inpaymentFirst_DATE,

        f.value_inpayment_first AS valueInpaymentFirst

    FROM first_inpay_day f

    ORDER BY
        f.sharer_id,
        f.effective_date ASC
),


/* ============================================================
   5. CREDIT TRANSACTIONS
   Один проход для основных кредитовых показателей.
   ============================================================ */

credit_tx AS MATERIALIZED (
    SELECT
        sb.sharer_id,
        sb.effective_date AS sharer_effective_date,

        t.effective_date,
        t.value,

        ot.code AS operation_code

    FROM sharer_base sb

    JOIN back_office.account a
      ON a.owner_sharer_id = sb.sharer_id

    JOIN back_office.transaction t
      ON t.credit_account_id = a.id

    JOIN back_office.operation o
      ON o.id = t.operation_id

    JOIN back_office.operation_type ot
      ON ot.id = o.operation_type_id

    WHERE t.effective_date < v_datetime_end

      /*
       * Нижнюю границу из исходника сохраняем:
       * t.effective_date >= sb.effective_date
       */
      AND t.effective_date >= sb.effective_date

      /*
       * ВАЖНО:
       * сюда добавлены NPO_RETURN_*.
       *
       * В исходнике FILTER по ним был,
       * но общий WHERE их заранее отрезал.
       */
      AND ot.code IN (
          'PENSION_INVESTMENT_REVENUE_ENROLLMENT_PR',
          'DEPOSIT_ENROLLMENT',

          'NPO_RETURN_SUCCESSOR_PAYMENT',
          'NPO_RETURN_RPPO_PENSION_PAYMENT',
          'NPO_RETURN_REDEMPTION_SUM',
          'NPO_RETURN_NDFL_REDEMPTION'
      )
),

payments_credit AS MATERIALIZED (
    SELECT
        ct.sharer_id,

        sum(ct.value) FILTER (
            WHERE ct.operation_code =
                  'PENSION_INVESTMENT_REVENUE_ENROLLMENT_PR'
        ) AS incomeValueTotal,

        sum(ct.value) FILTER (
            WHERE ct.operation_code = 'DEPOSIT_ENROLLMENT'
              AND ct.effective_date >= p_start_date
              AND ct.effective_date <  v_datetime_end
        ) AS inpayment_value,

        sum(ct.value) FILTER (
            WHERE ct.operation_code = 'DEPOSIT_ENROLLMENT'
              AND ct.effective_date >= p_start_date - interval '1 year'
              AND ct.effective_date <  p_start_date
        ) AS transactionInpaymentValue1,

        sum(ct.value) FILTER (
            WHERE ct.operation_code = 'DEPOSIT_ENROLLMENT'
              AND ct.effective_date >= p_start_date - interval '2 year'
              AND ct.effective_date <  p_start_date - interval '1 year'
        ) AS transactionInpaymentValue2,

        sum(ct.value) FILTER (
            WHERE ct.operation_code = 'DEPOSIT_ENROLLMENT'
              AND ct.effective_date >= p_start_date - interval '3 year'
              AND ct.effective_date <  p_start_date - interval '2 year'
        ) AS transactionInpaymentValue3,

        sum(-ct.value) FILTER (
            WHERE ct.operation_code IN (
                'NPO_RETURN_SUCCESSOR_PAYMENT',
                'NPO_RETURN_RPPO_PENSION_PAYMENT',
                'NPO_RETURN_REDEMPTION_SUM',
                'NPO_RETURN_NDFL_REDEMPTION'
            )
              AND ct.effective_date >= p_start_date
              AND ct.effective_date <  v_datetime_end
        ) AS value_pay

    FROM credit_tx ct

    GROUP BY ct.sharer_id
),


/* ============================================================
   6. DEBIT TRANSACTIONS
   Один проход используется и для VALUE_PAY,
   и для даты последней пенсионной выплаты.
   ============================================================ */

debit_tx AS MATERIALIZED (
    SELECT
        sb.sharer_id,

        sb.effective_date AS sharer_effective_date,

        t.effective_date,
        t.value,

        ot.code AS operation_code

    FROM sharer_base sb

    JOIN back_office.account a
      ON a.owner_sharer_id = sb.sharer_id

    JOIN back_office.transaction t
      ON t.debit_account_id = a.id

    JOIN back_office.operation o
      ON o.id = t.operation_id

    JOIN back_office.operation_type ot
      ON ot.id = o.operation_type_id

    WHERE t.effective_date < v_datetime_end

      AND ot.code IN (
          'PAYMENT_PENSION',
          'NPO_NDFL_NONSTATE_PENSION',
          'NPO_WITHHOLDING_UNDER_WRIT_EXECUTION',
          'PAYMENT_TERMINATED',
          'NPO_NDFL_REDEMPTION',
          'PAYMENT_SUCCESSOR',
          'NPO_NDFL_SUCCESSOR'
      )
),

payments_debit AS MATERIALIZED (
    SELECT
        dt.sharer_id,

        sum(dt.value) AS value_pay

    FROM debit_tx dt

    WHERE dt.effective_date = dt.sharer_effective_date

    GROUP BY dt.sharer_id
),

last_pension_payment AS MATERIALIZED (
    SELECT
        dt.sharer_id,
        max(dt.effective_date) AS effective_date

    FROM debit_tx dt

    WHERE dt.operation_code = 'PAYMENT_PENSION'

    GROUP BY dt.sharer_id
),

next_pay_pension_date AS MATERIALIZED (
    SELECT
        sb.sharer_id,

        CASE
            WHEN sb.period_pay_pension = 'год'
                THEN lpp.effective_date + interval '1 year'

            WHEN sb.period_pay_pension = 'полугодие'
                THEN lpp.effective_date + interval '6 months'

            WHEN sb.period_pay_pension = 'квартал'
                THEN lpp.effective_date + interval '3 months'

            WHEN sb.period_pay_pension = 'месяц'
                THEN lpp.effective_date + interval '1 month'

            ELSE NULL
        END AS pension_next_pay_date

    FROM sharer_base sb

    JOIN last_pension_payment lpp
      ON lpp.sharer_id = sb.sharer_id
),


/* ============================================================
   7. BALANCE
   Два старых CTE объединяем в один проход.
   ============================================================ */

balances AS MATERIALIZED (
    SELECT
        sb.sharer_id,

        greatest(
            coalesce(
                sum(
                    b.total_credit - b.total_debit
                ) FILTER (
                    WHERE b.start_date <= p_end_date
                      AND b.end_date   >= p_end_date
                ),
                0
            ),
            0
        ) AS balance_end,

        greatest(
            coalesce(
                sum(
                    b.total_credit - b.total_debit
                ) FILTER (
                    WHERE sb.start_date_pension IS NOT NULL
                      AND b.start_date <= sb.start_date_pension
                      AND b.end_date   >= sb.start_date_pension
                ),
                0
            ),
            0
        ) AS balance_by_pension_start

    FROM sharer_base sb

    JOIN back_office.account a
      ON a.owner_sharer_id = sb.sharer_id

    JOIN back_office.balance b
      ON b.account_id = a.id
     AND (
            (
                b.start_date <= p_end_date
                AND b.end_date >= p_end_date
            )
            OR
            (
                sb.start_date_pension IS NOT NULL
                AND b.start_date <= sb.start_date_pension
                AND b.end_date >= sb.start_date_pension
            )
         )

    GROUP BY sb.sharer_id
),


/* ============================================================
   8. STATUS_SHARER
   ============================================================ */

sharer_status_calc AS MATERIALIZED (
    SELECT
        sb.sharer_id,

        bal.balance_end AS balance_value,

        CASE
            WHEN sb.obligation_types IN (
                    'ОНПП',
                    'ОНСП',
                    'ОНИП'
                 )
             AND sb.suspend_pay_date IS NOT NULL
                THEN 'ПВП'


            WHEN sb.individual_sharer_status = 'Выбывший'
             AND sb.transfer_out_all_redemption_sharer_id IS NOT NULL
                THEN 'ВС'


            WHEN coalesce(
                    sb.end_date_pay_pension,
                    DATE '2050-01-01'
                 )
                 BETWEEN p_start_date AND p_end_date
             AND coalesce(bal.balance_end, 0) = 0
             AND sb.individual_sharer_status = 'Выбывший'
                THEN 'b'       -- !!! оставил значение как на фото


            WHEN sb.individual_sharer_status = 'Выбывший'
             AND coalesce(
                    sb.death_date,
                    DATE '2050-01-01'
                 ) < p_end_date
                THEN 'СМ'


            WHEN coalesce(
                    sb.birth_date,
                    DATE '1901-01-01'
                 ) = DATE '1901-01-01'
                THEN 'прочие'


            WHEN sb.obligation_types IN (
                    'ОНПП',
                    'ОНСП',
                    'ОНИП'
                 )
                THEN 'ПВ'


            /* -----------------------------------------------
               Пенсионный возраст + действующий
               ----------------------------------------------- */
            WHEN
                CASE
                    WHEN sb.sex_raw = 'F'
                     AND sb.sign_date < DATE '2019-01-01'
                        THEN sb.birth_date + interval '55 year'

                    WHEN sb.sex_raw = 'M'
                     AND sb.sign_date < DATE '2019-01-01'
                        THEN sb.birth_date + interval '60 year'

                    WHEN sb.sex_raw = 'F'
                     AND sb.sign_date >= DATE '2019-01-01'
                        THEN sb.birth_date
                           + interval '55 year'
                           + interval '6 month'

                    WHEN sb.sex_raw = 'M'
                     AND sb.sign_date >= DATE '2019-01-01'
                        THEN sb.birth_date
                           + interval '60 year'
                           + interval '6 month'
                END <= p_end_date

             AND sb.individual_sharer_status = 'Действующий'
                THEN 'ВПН'


            /* -----------------------------------------------
               Пенсионный возраст + выбывший +
               заявление на расторжение
               ----------------------------------------------- */
            WHEN
                CASE
                    WHEN sb.sex_raw = 'F'
                     AND sb.sign_date < DATE '2019-01-01'
                        THEN sb.birth_date + interval '55 year'

                    WHEN sb.sex_raw = 'M'
                     AND sb.sign_date < DATE '2019-01-01'
                        THEN sb.birth_date + interval '60 year'

                    WHEN sb.sex_raw = 'F'
                     AND sb.sign_date >= DATE '2019-01-01'
                        THEN sb.birth_date
                           + interval '55 year'
                           + interval '6 month'

                    WHEN sb.sex_raw = 'M'
                     AND sb.sign_date >= DATE '2019-01-01'
                        THEN sb.birth_date
                           + interval '60 year'
                           + interval '6 month'
                END <= p_end_date

             AND sb.individual_sharer_status = 'Выбывший'
             AND sb.appl_term_sharer_id IS NOT NULL
             AND sb.transfer_out_all_redemption_sharer_id IS NULL
                THEN 'ВПН'


            WHEN sb.individual_sharer_status = 'Действующий'
                THEN 'НП'


            WHEN sb.individual_sharer_status = 'Выбывший'
             AND sb.appl_term_sharer_id IS NOT NULL
             AND sb.transfer_out_all_redemption_sharer_id IS NULL
                THEN 'НП'


            ELSE 'прочие'
        END AS status_sharer

    FROM sharer_base sb

    LEFT JOIN balances bal
      ON bal.sharer_id = sb.sharer_id
),


/* ============================================================
   9. ФИНАЛЬНЫЙ РЕЗУЛЬТАТ ФИЗЛИЦ
   ============================================================ */

res AS (
    SELECT
        sb.sharer_code_1c::integer
            AS nn,

        sb.code
            AS code,

        sb.contract_code_1c::integer
            AS code_contract,

        sb.sharer_code_1c::integer
            AS code_sharer,

        sb.sharer_number::text
            AS selfnumber_sharer,

        sb.contract_number::text
            AS selfnumber_contract,

        sb.sign_date::date
            AS sign_date,

        sb.effective_date::date
            AS effective_date,

        fi.inpaymentFirst_DATE::date
            AS inpaymentFirst_DATE,

        sb.name_investor::text
            AS name_investor,

        sb.investor_sharer::integer
            AS investor_sharer,

        coalesce(
            ssc.status_sharer,
            'прочие'
        )::text
            AS status_sharer,

        sb.sex::text
            AS sex,

        sb.birth_date::date
            AS birth_date,

        sb.fund::text
            AS fund,

        ps.pension_scheme_name::text
            AS scheme_contract,

        ps.pension_scheme_name::text
            AS scheme_name,

        sb.investment_portfolio_name::text
            AS portfolioInvest,

        sb.account_type::text
            AS account_type,

        sb.registr_date::date
            AS registr_date,

        sb.class_sharer::integer
            AS class_sharer,

        ps.oud::numeric
            AS oud,

        NULL::bigint
            AS segment,

        coalesce(
            sb.value_income,
            0
        )::numeric
            AS value_income,


        /* ----------------------------------------------------
           PERIOD_INCOME
           ---------------------------------------------------- */
        CASE
            WHEN sb.type_investor = 'ЮЛ'
                THEN 'другой период (указать)'

            WHEN sb.type_investor = 'ФЛ'
                THEN
                    CASE
                        WHEN coalesce(ps.mgd_accum, 0) >= 0
                         AND coalesce(ps.mgd_pay, 0) >= 0
                            THEN 'период действия пенсионного договора'

                        WHEN coalesce(ps.mgd_accum, 0) > 0
                         AND coalesce(ps.mgd_pay, 0) = 0
                            THEN 'период накопления'

                        WHEN coalesce(ps.mgd_pay, 0) > 0
                         AND coalesce(ps.mgd_accum, 0) = 0
                            THEN 'период выплат'

                        ELSE 'период действия пенсионного договора'
                    END
        END::text
            AS period_income,


        ps.assignee_type::text
            AS assignee_type,

        ps.valueInpaymentContract::numeric
            AS valueInpaymentContract,

        sb.get_actuary_rate::integer
            AS get_actuary_rate,

        bal.balance_end::numeric
            AS balance_end,

        bal.balance_end::numeric
            AS balance_end_ips,

        NULL::numeric
            AS balance_transfer,

        pc.incomeValueTotal::numeric
            AS incomeValueTotal,

        pc.inpayment_value::numeric
            AS inpayment_value,

        NULL::numeric
            AS othertransfer_value,


        (
            coalesce(pd.value_pay, 0)
          + coalesce(pc.value_pay, 0)
        )::numeric
            AS value_pay,


        'Фондированная'::text
            AS "CONDITION",


        CASE
            WHEN sb.account_type = 'СПС'
                THEN 'Фонд, в пределах остатка счета'

            WHEN sb.account_type = 'ИПС'
                THEN 'Фонд, в объеме обязательств по выплате'
        END::text
            AS respons,


        sb.start_date_pension::date
            AS start_date_pension,

        sb.period_pension::text
            AS period_pension,

        sb.pension_value::numeric
            AS pension_value,

        NULL::bigint
            AS indexation,

        nppd.pension_next_pay_date::date
            AS pension_next_pay_date,

        sb.suspend_pay_date::date
            AS suspend_pay_date,

        sb.period_pay_pension::text
            AS period_pay_pension,

        sb.end_date_pension_period::date
            AS end_date_pension_period,

        sb."TYPE"::integer
            AS "TYPE",

        NULL::bigint
            AS fixed_value,

        sb.actuary_rate::numeric
            AS actuary_rate,

        NULL::numeric
            AS valueReturn,

        pc.transactionInpaymentValue1::numeric
            AS transactionInpaymentValue1,

        pc.transactionInpaymentValue2::numeric
            AS transactionInpaymentValue2,

        pc.transactionInpaymentValue3::numeric
            AS transactionInpaymentValue3,

        sb.age::smallint
            AS age,

        sb.type_group::text
            AS type_group,

        sb.contract_type::integer
            AS contract_type,

        sb.pension_count::integer
            AS pension_count,

        sb.end_date_pay_pension::date
            AS end_date_pay_pension,

        sb.sharer_type::text
            AS sharer_type,

        fi.valueInpaymentFirst::numeric
            AS valueInpaymentFirst,

        bal.balance_by_pension_start::numeric
            AS balanceByPensionStart,

        sb.name_in_pfr::text
            AS fund_source

    FROM sharer_base sb

    LEFT JOIN payments_credit pc
      ON pc.sharer_id = sb.sharer_id

    LEFT JOIN payments_debit pd
      ON pd.sharer_id = sb.sharer_id

    LEFT JOIN first_inpay fi
      ON fi.sharer_id = sb.sharer_id

    LEFT JOIN balances bal
      ON bal.sharer_id = sb.sharer_id

    LEFT JOIN next_pay_pension_date nppd
      ON nppd.sharer_id = sb.sharer_id

    LEFT JOIN sharer_status_calc ssc
      ON ssc.sharer_id = sb.sharer_id

    LEFT JOIN pension_scheme ps
      ON ps.sharer_id = sb.sharer_id
)

