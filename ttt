-- Выплата сберегательных взносов ПДС
if p_calc_type = 'PAYMENT'
   and v_service_type = 'PDS'
   and v_is_nonstandard = false
then

    return query

    with base as (
        select
            s.id,
            s.contract_id,

            case
                when appl.individual_id = c.individual_id
                     and appl.individual_id != s.individual_id
                    then 'Вкладчик'

                when appl.individual_id = s.individual_id
                    then 'Участник'

                when c.individual_id = s.individual_id
                    then 'Участник'

                else 'Вкладчик'
            end as who

        from ourpension.sharer s

        join ourpension.contract c
            on c.id = s.contract_id

        left join lateral (
            select distinct on (atc.sharer_id)
                atc.sharer_id,
                atc.application_personal_data_individual_id as individual_id
            from ourpension.application_termination_contract atc
            where atc.sharer_id = s.id
              and atc."date" <= p_calc_date
            order by
                atc.sharer_id,
                atc."date" desc,
                atc."version" desc
        ) appl on true

        where s.id = p_sharer_id
    ),

    -- Настройки расчёта
    settings as materialized (
        select
            sc.operation_type_code,
            sc.mnemonics,
            sc.direction,
            sc.s_ts
        from actuary.settings_for_redemption_calculation sc
        where sc."service_type" = 'PDS'
          and sc.calculation_type = 'PAYMENT'
    ),

    -- Все разрешённые коды операций и мнемоники кредита
    credit_settings as (
        select distinct operation_type_code
        from settings
        where direction = 'credit'
          and operation_type_code is not null
    ),

    credit_mnemonics as (
        select distinct mnemonics
        from settings
        where direction = 'credit'
          and mnemonics is not null
    ),

    debit_settings as (
        select distinct operation_type_code
        from settings
        where direction = 'debit'
          and operation_type_code is not null
    ),

    -- Поступления
    trans_raw_credit as (
        select
            s.id,
            ot.code as operation_name,
            at2.mnemonics,
            sum(t.value) as trans_amount

        from back_office.operation o

        join back_office.transaction t
            on t.operation_id = o.id

        join back_office.account a
            on a.id = t.credit_account_id

        join back_office.account_type at2
            on at2.id = a.account_type_id

        join ourpension.sharer s
            on s.id = a.owner_sharer_id

        join back_office.operation_type ot
            on ot.id = o.operation_type_id

        where s.id = p_sharer_id
          and t.effective_date <= p_calc_date
          and (
              exists (
                  select 1
                  from credit_settings cs
                  where cs.operation_type_code = ot.code
              )
              or exists (
                  select 1
                  from credit_mnemonics cm
                  where cm.mnemonics = at2.mnemonics
              )
          )

        group by
            s.id,
            ot.code,
            at2.mnemonics
    ),

    -- Списания
    trans_raw_debit as (
        select
            s.id,
            ot.code as operation_name,
            sum(t.value) as trans_amount

        from back_office.operation o

        join back_office.transaction t
            on t.operation_id = o.id

        join back_office.account a
            on a.id = t.debit_account_id

        join ourpension.sharer s
            on s.id = a.owner_sharer_id

        join back_office.operation_type ot
            on ot.id = o.operation_type_id

        where s.id = p_sharer_id
          and t.effective_date <= p_calc_date
          and exists (
              select 1
              from debit_settings ds
              where ds.operation_type_code = ot.code
          )

        group by
            s.id,
            ot.code
    ),

    -- Расчёт поступлений по типам сумм
    trans_calc_credit as (
        select
            trc.id,

            coalesce(
                sum(trc.trans_amount) filter (
                    where exists (
                        select 1
                        from settings sc
                        where sc.direction = 'credit'
                          and sc.s_ts = 's_vznos'
                          and (
                              sc.operation_type_code = trc.operation_name
                              or sc.mnemonics = trc.mnemonics
                          )
                    )
                ),
                0
            ) as s_vznos,

            coalesce(
                sum(trc.trans_amount) filter (
                    where exists (
                        select 1
                        from settings sc
                        where sc.direction = 'credit'
                          and sc.s_ts = 's_finrez'
                          and (
                              sc.operation_type_code = trc.operation_name
                              or sc.mnemonics = trc.mnemonics
                          )
                    )
                ),
                0
            ) as s_finrez,

            coalesce(
                sum(trc.trans_amount) filter (
                    where exists (
                        select 1
                        from settings sc
                        where sc.direction = 'credit'
                          and sc.s_ts = 's_vosp'
                          and (
                              sc.operation_type_code = trc.operation_name
                              or sc.mnemonics = trc.mnemonics
                          )
                    )
                ),
                0
            ) as s_vosp,

            coalesce(
                jsonb_agg(
                    jsonb_build_object(
                        'mnemonics', trc.mnemonics,
                        'operation_name', trc.operation_name,
                        'amount', trc.trans_amount
                    )
                    order by trc.mnemonics, trc.operation_name
                ),
                '[]'::jsonb
            ) as credit_included_json

        from trans_raw_credit trc

        group by trc.id
    ),

    -- Проверка разовых / дополнительных взносов
    coeff_prepare as (
        select
            trc.id,

            bool_or(
                exists (
                    select 1
                    from settings sc
                    where sc.direction = 'credit'
                      and sc.s_ts = 'onetime_or_add'
                      and sc.operation_type_code = trc.operation_name
                )
            ) as is_onetime_or_add_contribution

        from trans_raw_credit trc

        group by trc.id
    ),

    -- Расчёт выплат
    trans_calc_debit as (
        select
            trd.id,

            coalesce(
                sum(trd.trans_amount) filter (
                    where exists (
                        select 1
                        from settings sc
                        where sc.direction = 'debit'
                          and sc.s_ts = 's_vypl'
                          and sc.operation_type_code = trd.operation_name
                    )
                ),
                0
            ) as s_vypl,

            coalesce(
                jsonb_agg(
                    jsonb_build_object(
                        'operation_name', trd.operation_name,
                        'amount', trd.trans_amount
                    )
                    order by trd.operation_name
                ),
                '[]'::jsonb
            ) as debit_included_json

        from trans_raw_debit trd

        group by trd.id
    ),

    -- Прочие поступления
    not_included_trans_credit as (
        select
            s.id,
            ot.code as operation_name,
            at2.mnemonics,
            sum(t.value) as trans_amount

        from back_office.operation o

        join back_office.transaction t
            on t.operation_id = o.id

        join back_office.account a
            on a.id = t.credit_account_id

        join back_office.account_type at2
            on at2.id = a.account_type_id

        join ourpension.sharer s
            on s.id = a.owner_sharer_id

        join back_office.operation_type ot
            on ot.id = o.operation_type_id

        where s.id = p_sharer_id
          and t.effective_date = p_calc_date
          and not exists (
              select 1
              from trans_raw_credit trc
              where trc.operation_name = ot.code
                and trc.mnemonics is not distinct from at2.mnemonics
          )

        group by
            s.id,
            ot.code,
            at2.mnemonics
    ),

    not_included_trans_credit_json as (
        select
            nit.id,

            jsonb_agg(
                jsonb_build_object(
                    'mnemonics', nit.mnemonics,
                    'operation_name', nit.operation_name,
                    'amount', nit.trans_amount
                )
                order by nit.mnemonics, nit.operation_name
            ) as credit_not_included_json

        from not_included_trans_credit nit
        group by nit.id
    ),

    -- Прочие списания
    not_included_trans_debit as (
        select
            s.id,
            ot.code as operation_name,
            sum(t.value) as trans_amount

        from back_office.operation o

        join back_office.transaction t
            on t.operation_id = o.id

        join back_office.account a
            on a.id = t.debit_account_id

        join ourpension.sharer s
            on s.id = a.owner_sharer_id

        join back_office.operation_type ot
            on ot.id = o.operation_type_id

        where s.id = p_sharer_id
          and t.effective_date = p_calc_date
          and not exists (
              select 1
              from trans_raw_debit trd
              where trd.operation_name = ot.code
          )

        group by
            s.id,
            ot.code
    ),

    not_included_trans_debit_json as (
        select
            nit.id,

            jsonb_agg(
                jsonb_build_object(
                    'operation_name', nit.operation_name,
                    'amount', nit.trans_amount
                )
                order by nit.operation_name
            ) as debit_not_included_json

        from not_included_trans_debit nit
        group by nit.id
    ),

    -- Исходные суммы
    calc_params as (
        select
            coalesce(tcc.s_vznos, 0) as s_vznos,
            coalesce(tcc.s_finrez, 0) as s_finrez,
            coalesce(tcc.s_vosp, 0) as s_vosp,
            coalesce(tcd.s_vypl, 0) as s_vypl

        from base b

        left join trans_calc_credit tcc
            on tcc.id = b.id

        left join trans_calc_debit tcd
            on tcd.id = b.id
    ),

    -- Коэффициенты
    coeff_params as (
        select
            coalesce(t.k1, 1)::numeric as k1,
            coalesce(t.k2, 1)::numeric as k2,

            case
                when t.sharer_id is null then
                    jsonb_build_object(
                        'code', 'REDEMPTION_COEFF_NOT_FOUND',
                        'message',
                        'Функция получения коэффициентов не вернула строк'
                    )
                else t.details_json
            end as details_json

        from base b

        left join coeff_prepare tcc
            on tcc.id = b.id

        left join lateral (
            select
                grc.sharer_id,
                grc.k1,
                grc.k2,
                grc.details_json

            from actuary.get_redemption_coeff(
                b.id,
                '{}'::integer[],
                'PDS',
                p_calc_date,
                b.who,
                tcc.is_onetime_or_add_contribution,
                null
            ) grc

            where grc.sharer_id = b.id
        ) t on true
    ),

    -- Выкупная сумма: исходная формула
    calc_vykup as (
        select
            greatest(
                0,
                cp1.k1 * coalesce(cp.s_vznos, 0)
                + cp1.k2 * (
                    coalesce(cp.s_finrez, 0)
                    + coalesce(cp.s_vosp, 0)
                )
                - coalesce(cp.s_vypl, 0)
            ) as s_vykup

        from calc_params cp
        cross join coeff_params cp1
    ),

    -- Суммы, относящиеся к страховым резервам
    sr_source as (
        select
            trc.id,
            trc.mnemonics,
            trc.operation_name,
            trc.trans_amount

        from trans_raw_credit trc

        where exists (
            select 1
            from settings sc
            where sc.direction = 'credit'
              and sc.s_ts = 's_vznos'
              and (
                  sc.operation_type_code = trc.operation_name
                  or sc.mnemonics = trc.mnemonics
              )
        )
    ),

    sr_calc as (
        select
            coalesce(
                sum(s.trans_amount),
                0
            )::numeric as s_sr,

            coalesce(
                jsonb_agg(
                    jsonb_build_object(
                        'mnemonics', s.mnemonics,
                        'operation_name', s.operation_name,
                        'amount', s.trans_amount
                    )
                    order by s.mnemonics, s.operation_name
                ) filter (where s.id is not null),
                '[]'::jsonb
            ) as sr_details

        from sr_source s
    )

    select

        -- Выкупная сумма
        coalesce((
            select r.pension
            from actuary.round_calc_res(
                v_round_type,
                cv.s_vykup,
                v_service_type
            ) r
        ), 0)::numeric,

        -- Сберегательные взносы
        coalesce((
            select r.pension
            from actuary.round_calc_res(
                v_round_type,
                cp.s_vznos,
                v_service_type
            ) r
        ), 0)::numeric,

        -- Дополнительный доход
        null::numeric as s_dd,

        -- Минимальный гарантированный доход
        null::numeric as s_mgd,

        -- Государственное софинансирование
        coalesce((
            select r.pension
            from actuary.round_calc_res(
                v_round_type,
                cp.s_vosp,
                v_service_type
            ) r
        ), 0)::numeric,

        -- Выплаты
        coalesce((
            select r.pension
            from actuary.round_calc_res(
                v_round_type,
                cp.s_vypl,
                v_service_type
            ) r
        ), 0)::numeric,

        -- Переводы
        null::numeric as s_perevod,

        -- Финансовый результат
        coalesce((
            select r.pension
            from actuary.round_calc_res(
                v_round_type,
                cp.s_finrez,
                v_service_type
            ) r
        ), 0)::numeric,

        -- Коэффициенты
        coalesce(cp1.k1, 0)::numeric,
        coalesce(cp1.k2, 0)::numeric,
        null::numeric,
        null::numeric,
        null::numeric,
        null::numeric as d,

        -- Детализация
        jsonb_build_object(

            'credit_included',
            coalesce(
                tcc.credit_included_json,
                '[]'::jsonb
            ),

            'credit_not_included',
            coalesce(
                nitcj.credit_not_included_json,
                '[]'::jsonb
            ),

            'debit_included',
            coalesce(
                tcd.debit_included_json,
                '[]'::jsonb
            ),

            'debit_not_included',
            coalesce(
                nitdj.debit_not_included_json,
                '[]'::jsonb
            ),

            's_sr',
            jsonb_build_object(
                'amount', sr.s_sr,
                'details', sr.sr_details
            ),

            'exception',
            jsonb_build_object(
                'error', cp1.details_json
            )

        )::jsonb as details_json

    from calc_params cp

    cross join coeff_params cp1

    cross join calc_vykup cv

    cross join sr_calc sr

    left join trans_calc_credit tcc
        on true

    left join trans_calc_debit tcd
        on true

    left join not_included_trans_credit_json nitcj
        on true

    left join not_included_trans_debit_json nitdj
        on true;

end if;
