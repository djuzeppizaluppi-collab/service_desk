AND EXISTS (
    SELECT 1
    FROM (
        SELECT
            x.dt,
            SUM(x.delta) OVER (
                ORDER BY x.dt
            ) AS total_balance
        FROM (
            SELECT
                GREATEST(b.start_date, p_start_date) AS dt,
                SUM(
                    COALESCE(b.total_credit, 0)
                    - COALESCE(b.total_debit, 0)
                ) AS delta
            FROM back_office.account a
            JOIN back_office.balance b
                ON b.account_id = a.id
            WHERE a.owner_contract_id = c.id
              AND b.start_date <= p_end_date
              AND b.end_date > p_start_date
            GROUP BY 1

            UNION ALL

            SELECT
                b.end_date AS dt,
                -SUM(
                    COALESCE(b.total_credit, 0)
                    - COALESCE(b.total_debit, 0)
                ) AS delta
            FROM back_office.account a
            JOIN back_office.balance b
                ON b.account_id = a.id
            WHERE a.owner_contract_id = c.id
              AND b.start_date <= p_end_date
              AND b.end_date > p_start_date
              AND b.end_date <= p_end_date
            GROUP BY 1
        ) x
    ) t
    WHERE t.total_balance > 0
)
